{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "FrameEyePointer",
  "description": "Right bumper clicks where you look, left bumper right-clicks, hold left View toggles, right thumbstick scrolls",
  "bindings": {
    "/actions/click": {
      "sources": [
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/click/in/press"
            }
          }
        }
      ]
    },
    "/actions/rightclick": {
      "sources": [
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/rightclick/in/press"
            }
          }
        }
      ]
    },
    "/actions/toggle": {
      "sources": [
        {
          "path": "/user/hand/left/input/view",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/toggle/in/press"
            }
          }
        }
      ]
    },
    "/actions/scroll": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/scroll/in/stick"
            }
          }
        }
      ]
    }
  }
}
