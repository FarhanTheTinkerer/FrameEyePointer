{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "frameeyepointer.pc",
  "category": "steamvr_input",
  "controller_type": "oculus_touch",
  "description": "Eye pointer clicks",
  "name": "Touch controllers",
  "options": {},
  "simulated_actions": [],
  "bindings": {
    "/actions/eyepointer": {
      "sources": [
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/eyepointer/in/click_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/eyepointer/in/click_right"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "button",
          "inputs": {
            "long": {
              "output": "/actions/eyepointer/in/toggle"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/eyepointer/in/scroll"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/eyepointer/out/haptic",
          "path": "/user/hand/right/output/haptic"
        },
        {
          "output": "/actions/eyepointer/out/haptic",
          "path": "/user/hand/left/output/haptic"
        }
      ]
    }
  }
}
